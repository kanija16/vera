# Database Settings (Local / Docker Compose)
POSTGRES_DB=vera
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@db:5432/vera

# Security
SECRET_KEY=vera_cryptographic_secret_key_2026

# Force Database Bootstrap (Drops public schema cascade on startup for clean reset)
DB_FORCE_BOOTSTRAP=true

# Blockchain settings (mock or polygon)
BLOCKCHAIN_MODE=mock
POLYGON_RPC_URL=
CONTRACT_ADDRESS=
PRIVATE_KEY=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
